<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>FieldKit</RootNamespace>
    <AssemblyName>FieldKit</AssemblyName>
    <Product>FieldKit — Developer Tools for SPT</Product>
    <Description>In-raid administration and testing utilities for SPT users and mod developers.</Description>
    <Nullable>disable</Nullable>
    <Authors>Hysocs</Authors>
    <AssemblyVersion>1.3.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <LangVersion>latest</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\.build\**</DefaultItemExcludes>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <FieldKitForceRebuildDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)</FieldKitForceRebuildDir>
    <FieldKitForceRebuildFile>$(FieldKitForceRebuildDir)\FieldKit.ForceRebuild.g.cs</FieldKitForceRebuildFile>
    <FieldKitBepInExReferenceRoot>$(MSBuildProjectDirectory)\references\Bepinex</FieldKitBepInExReferenceRoot>
    <FieldKitTarkovReferenceRoot>$(MSBuildProjectDirectory)\references\Tarkov</FieldKitTarkovReferenceRoot>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>False</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Compile Include="$(FieldKitForceRebuildFile)" AutoGen="true" DesignTime="false" Visible="false" />
    <EmbeddedResource Include="THIRD_PARTY_NOTICES.md" />
    <None Update="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PhysicsModule">
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(FieldKitBepInExReferenceRoot)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(FieldKitTarkovReferenceRoot)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(FieldKitBepInExReferenceRoot)\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(FieldKitTarkovReferenceRoot)\Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(FieldKitTarkovReferenceRoot)\Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(FieldKitTarkovReferenceRoot)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <FieldKitClientInstallDir>$(MSBuildProjectDirectory)\..\..\BepInEx\plugins\Hysocs-FieldKit</FieldKitClientInstallDir>
  </PropertyGroup>

  <Target Name="DeployFieldKitClient" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <MakeDir Directories="$(FieldKitClientInstallDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FieldKitClientInstallDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\THIRD_PARTY_NOTICES.md" DestinationFolder="$(FieldKitClientInstallDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="FieldKit client deployed: $(FieldKitClientInstallDir)\$(TargetFileName)" />
  </Target>

  <Target Name="ForceFieldKitClientRebuild" BeforeTargets="CoreCompile" Condition="'$(SkipForceRebuild)' != 'true'">
    <MakeDir Directories="$(FieldKitForceRebuildDir)" />
    <Touch Files="$(FieldKitForceRebuildFile)" AlwaysCreate="true" ForceTouch="true" />
  </Target>

</Project>
